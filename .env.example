# Server Configuration
PORT=3000
NODE_ENV=production

# Database Connection (MongoDB URI / MongoDB Atlas Connection String)
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/findmything?retryWrites=true&w=majority

# Session Security Secret (Use a strong random string in production)
SESSION_SECRET=your_super_secret_session_key_here

# Email Notification Service (Gmail App Password or SMTP)
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_email_app_password

# Initial Admin & Manager Credentials (Optional: Defaults used if omitted)
ADMIN_EMAIL=admin@findmything.com
ADMIN_PASSWORD=your_secure_admin_password
MANAGER_EMAIL=manager@findmything.com
MANAGER_PASSWORD=your_secure_manager_password

# to store the upload image (Clodinary)

CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Web Push Notifications (VAPID Keys)
VAPID_PUBLIC_KEY=your_vapid_public_key_here
VAPID_PRIVATE_KEY=your_vapid_private_key_here
VAPID_SUBJECT=mailto:admin@findmything.com
